# 内嵌双监听器部署：管理站与完整 API 同源。
VITE_API_URL_PREFIX=/api

# 独立静态托管时可改为完整 API 地址；WebSocket 未显式配置时会从 API 地址推导。
# VITE_API_URL_PREFIX=https://api.example.com/api
# VITE_WS_URL=wss://api.example.com/api/ws/frontend

# CORS 白名单（由后端读取）：英文逗号`,` 分隔多个来源
# CORS_ADMIN_ORIGINS=https://admin.example.com,https://admin2.example.com
# CORS_PUBLIC_ORIGINS=https://status.example.com,https://status2.example.com
